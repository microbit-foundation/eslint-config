{
  "name": "@microbit/eslint-config",
  "version": "0.0.0",
  "description": "Shared ESLint config for Micro:bit Educational Foundation TypeScript projects",
  "keywords": [
    "eslint",
    "eslintconfig"
  ],
  "type": "module",
  "author": "Matt Hillsdon <matt.hillsdon@microbit.org>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/microbit-foundation/eslint-config"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./index.js",
    "./react": "./react.js"
  },
  "files": [
    "index.js",
    "react.js",
    "lib"
  ],
  "packageManager": "npm@11.18.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write --list-different .",
    "format:check": "prettier --check .",
    "test": "node --test \"test/*.test.js\"",
    "ci": "npm run lint && npm run format:check && npm run test"
  },
  "dependencies": {
    "@eslint-react/eslint-plugin": "^5.18.6",
    "@eslint/js": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript-eslint": "^8.68.0"
  },
  "peerDependencies": {
    "eslint": "^10.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "eslint": "^10.0.0",
    "globals": "^17.11.0",
    "prettier": "3.9.6",
    "react": "^19.0.0",
    "typescript": "^5.9.0"
  }
}
